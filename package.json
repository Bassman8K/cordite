{
  "name": "cordite",
  "productName": "Cordite",
  "version": "0.2.0",
  "private": true,
  "description": "CORDITE - a lightweight single-player tactical shooter with a six-chapter campaign, human enemies with real voices and an arsenal of 450+ real-world weapons.",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "icons": "node scripts/make-icons.mjs",
    "desktop": "npm run build && electron .",
    "smoke": "electron . --smoke-test=smoke",
    "dist": "npm run build && electron-builder --publish never",
    "site": "node scripts/build-site.mjs",
    "android:sync": "npm run build && cap sync android",
    "ios:sync": "npm run build && cap sync ios"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@fontsource-variable/oxanium": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@types/three": "^0.187.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "sharp": "^0.35.5",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "author": {
    "name": "Bassman8K",
    "email": "113654202+Bassman8K@users.noreply.github.com"
  },
  "homepage": "https://bassman8k.github.io/cordite/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bassman8K/cordite.git"
  },
  "build": {
    "appId": "io.github.bassman8k.cordite",
    "productName": "Cordite",
    "copyright": "Copyright (c) 2026 Bassman8K",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "publish": null,
    "mac": {
      "category": "public.app-category.action-games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Cordite-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Cordite",
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Cordite-Setup-win-x64.${ext}",
      "differentialPackage": false,
      "shortcutName": "Cordite"
    },
    "portable": {
      "artifactName": "Cordite-Portable-win-x64.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "synopsis": "Lightweight single-player tactical shooter",
      "executableName": "cordite"
    },
    "afterPack": "./scripts/after-pack.cjs",
    "appImage": {
      "artifactName": "Cordite-linux-x64.${ext}"
    },
    "deb": {
      "artifactName": "Cordite-linux-x64.${ext}"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
